# Generated by benchmantic from the input mapping (DuMux):
# the benchmark's software-neutral parameters are read from parameters.json
# and each DuMux input is computed from them (see *_mapping.json).
import json
import os
from pathlib import Path

container_image = 'ghcr.io/simulation-benchmarks/dumux-taylor-couette:3.11-dev'
# BENCHMARK_CONTAINER (e.g. a .sif built in CI) overrides the published image
container_uri = os.environ.get("BENCHMARK_CONTAINER") or f"docker://{container_image}"
container_shared_dir = '/dumux/shared'
executable = 'test_ff_navierstokes_taylorcouette'
build_dir = '/dumux/dumux/build-cmake/test/freeflow/navierstokes/taylorcouette'

with open("parameters.json") as f:
    config = json.load(f)
conf_name = config.get('configuration', 'case')

# benchmark parameters
def tokens(value):
    items = value if isinstance(value, (list, tuple)) else str(value).replace("(", " ").replace(")", " ").split()
    out = []
    for item in items:
        try:
            num = float(item)
            out.append(int(num) if num.is_integer() and "." not in str(item) else num)
        except (TypeError, ValueError):
            out.append(item)
    return out

cells_azimuthal = config['cells_azimuthal']
cells_radial = config['cells_radial']
global_refinement = config['global_refinement']
inner_angular_velocity = config['inner_angular_velocity[rad/s]']
outer_angular_velocity = config['outer_angular_velocity[rad/s]']
radii = config['radii[m]']
simulation_name = config['simulation_name']

zip_name = f"{simulation_name}.zip"

rule all:
    input:
        "solution_metrics.json",
        zip_name

rule run_simulation:
    input:
        rc_parameters_file = "parameters.json"
    output:
        zip = zip_name,
        metrics = "solution_metrics.json"
    resources:
        serial_run=1
    singularity:
        container_uri
    run:
        shell(
            f"""
            set -euo pipefail
            cd {build_dir}
            ./{executable} \
            -Grid.Radial0 "{radii}" \
            -Grid.Cells0 "{cells_radial}" \
            -Grid.Cells1 "{cells_azimuthal}" \
            -Grid.Refinement "{global_refinement}" \
            -Problem.Omega1 "{inner_angular_velocity}" \
            -Problem.Omega2 "{outer_angular_velocity}" \
            -Problem.Name "{container_shared_dir}/results/{conf_name}/{simulation_name}"
            """
        )
